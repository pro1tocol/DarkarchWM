# Global properties
#
# The top properties below are applied to every block, but can be overridden.
# Each block command defaults to the script name to avoid boilerplate.
#command=$HOME/.config/i3/sh/*
separator_block_width=18
markup=none

# Disk usage
[disk]
label=
command=echo " $(df -h / | awk 'NR==2 {print $5}')"
interval=3

# Memory usage
[memory]
label=
#command=echo " mem:$(free | grep 内存： | awk '{printf "%.0f\n", $3/$2 * 100}')%"
command=echo " $(free | grep Mem: | awk '{printf "%.0f\n", $3/$2 * 100}')%"
interval=3

# CPU usage
[cpu_usage]
label=
command=echo " $(mpstat --dec=0 | awk 'NR==4 {print 100 - $NF}')%"
interval=3

# Temperature status
[temperature]
label=
command=echo " $(awk '{print $1 / 1000}' /sys/class/thermal/thermal_zone*/temp | head -n 1)°C"
color=#00FFFF
interval=3

# Load status
[load_average]
label= 
command=echo "$(cat /proc/loadavg | awk '{print $1}')"
color=#00FFFF
interval=3

# User status
[user]
min_width=800
label=
command=echo " $(w | awk '/load average:/ {print $4,$5}' | grep -Eo '[1-9]')"
color=#00FFFF
interval=3

# Date status
[date]
#min_width=10
label= 
command=echo "$(date '+%m.%d')"
#command=date '+%Y-%m-%d %H:%M:%S'
interval=360

#[window title]
#command=xdotool getactivewindow getwindowname
#interval=1

# time
[time]
label=
command=echo " $(date '+%H:%M')"
interval=60
min_width=800

# Network interface monitoring
[iface]
label= 
command=echo "$(ip addr show | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' | grep -v '127.0.0' | head -n 1)"
interval=3
color=#00FFFF
align=right

# Volume setup
[volume]
label=
command=echo " $(pactl get-sink-volume alsa_output.pci-0000_03_00.6.analog-stereo | awk '/Volume:/ {print $5}')"
interval=1

# Battery indicator
[battery]
label= 
# show path
# ls /sys/class/power_supply/ | grep -E 'BAT[0-9]+|battery_BAT[0-9]+'
command=echo "$(cat /sys/class/power_supply/BAT0/capacity)%"
interval=3

# Light setup
[light]
label=󰛨
command=echo "$(brightnessctl | awk '/Current brightness:/ {print $4}') "
interval=1

