# group_class
for_window [class="gnome-calculator"] floating enable
for_window [class="mpv"] floating enable
for_window [class="gwenview"] floating enable

# group_instance
for_window [instance="netease-cloud-music"] floating enable
for_window [instance="systemsettings"] floating enable
for_window [instance="wechat"] floating enable
for_window [instance="dolphin"] floating enable
for_window [instance="code"] floating enable
for_window [instance="putty"] floating enable

# group_keys
bindsym --release $mod+p exec --no-startup-id screenkey -p fixed -g 15%x8%+80%-2%
bindsym --release $mod+s exec --no-startup-id plasma-open-settings
bindsym --release $mod+d exec --no-startup-id dolphin
bindsym --release $mod+f exec --no-startup-id firefox
bindsym --release $mod+c exec --no-startup-id code
bindsym --release $mod+t exec --no-startup-id putty
