XTerm*faceName: MesloLGM Nerd Font
XTerm*faceNameDoublesize: Microsoft YaHei
xterm*faceSize: 14
xterm*vt100*geometry: 106x32
xterm*saveLines: 16384
xterm*scrollBar: false
xterm*termName: xterm-color
xterm*eightBitInput: false
xterm*background: black
xterm*foreground: #EAEAEF
xterm*VT100.Translations: #override \
    Alt <Key> minus: smaller-vt-font() \n\
    Alt <Key> plus: larger-vt-font() \n\
    Alt <Key> 0: set-vt-font(d)
